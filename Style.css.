
/* ===== HERO ===== */

.hero{
    min-height:90vh;
    display:flex;
    justify-content:center;
    align-items:center;
    text-align:center;
    padding:40px;
    background:linear-gradient(rgba(0,0,0,.7),rgba(0,0,0,.7)),
    url("https://images.unsplash.com/photo-1520607162513-77705c0f0d4a?auto=format&fit=crop&w=1600&q=80");
    background-size:cover;
    background-position:center;
}

.hero-content{
    max-width:800px;
}

.hero h1{
    font-size:58px;
    margin-bottom:20px;
    color:#d4af37;
}

.hero p{
    font-size:20px;
    margin-bottom:35px;
}

.btn{
    display:inline-block;
    padding:15px 35px;
    border-radius:8px;
    font-weight:bold;
    transition:.3s;
    margin:10px;
}

.gold-btn{
    background:#d4af37;
    color:#111;
}

.gold-btn:hover{
    background:#f1c84b;
}

.dark-btn{
    border:2px solid #d4af37;
    color:#fff;
}

.dark-btn:hover{
    background:#d4af37;
    color:#111;
}
/* ===== STATS ===== */

.stats{
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
    gap:30px;
    padding:80px 8%;
    background:#151515;
}

.stat-box{
    background:#1f1f1f;
    padding:30px;
    border-radius:12px;
    width:220px;
    text-align:center;
    border:1px solid #d4af37;
}

.stat-box h2{
    color:#d4af37;
    font-size:38px;
    margin-bottom:10px;
}

.stat-box p{
    color:#ddd;
}

/* ===== ABOUT ===== */

.about{
    padding:100px 8%;
    text-align:center;
}

.about h2{
    color:#d4af37;
    font-size:42px;
    margin-bottom:25px;
}

.about p{
    max-width:900px;
    margin:0 auto 50px;
    color:#ddd;
}

.features{
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
    gap:30px;
}

.feature{
    background:#1b1b1b;
    padding:30px;
    border-radius:12px;
    width:300px;
    border:1px solid #333;
}

.feature h3{
    color:#d4af37;
    margin-bottom:15px;
}

/* ===== PLANS ===== */

.plans{
    padding:100px 8%;
    text-align:center;
}

.plans h2{
    color:#d4af37;
    font-size:42px;
    margin-bottom:50px;
}

.cards{
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
    gap:30px;
}

.card{
    background:#1b1b1b;
    width:320px;
    padding:35px;
    border-radius:15px;
    border:1px solid #333;
    transition:.3s;
}

.card:hover{
    transform:translateY(-10px);
    border-color:#d4af37;
}

.card h3{
    color:#d4af37;
}

.card h1{
    margin:20px 0;
    font-size:48px;
}

.card ul{
    margin:25px 0;
}

.card li{
    margin:10px 0;
}
/* ===== TESTIMONIALS ===== */

.testimonials{
    padding:100px 8%;
    text-align:center;
    background:#151515;
}

.testimonials h2{
    color:#d4af37;
    font-size:42px;
    margin-bottom:50px;
}

.testimonial-grid{
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
    gap:30px;
}

.testimonial{
    width:320px;
    background:#1b1b1b;
    padding:30px;
    border-radius:12px;
    border:1px solid #333;
}

.testimonial h4{
    margin-top:20px;
    color:#d4af37;
}

/* ===== FAQ ===== */

.faq{
    padding:100px 8%;
}

.faq h2{
    text-align:center;
    color:#d4af37;
    margin-bottom:40px;
}

.faq-item{
    background:#1b1b1b;
    padding:25px;
    margin-bottom:20px;
    border-radius:10px;
}

.faq-item h3{
    color:#d4af37;
    margin-bottom:10px;
}

/* ===== CONTACT ===== */

.contact{
    padding:100px 8%;
    text-align:center;
}

.contact h2{
    color:#d4af37;
    margin-bottom:25px;
}

.contact p{
    margin:10px 0;
}

/* ===== FOOTER ===== */

footer{
    background:#111;
    text-align:center;
    padding:30px;
    color:#aaa;
}

/* ===== MOBILE ===== */

@media (max-width:768px){

.navbar{
    flex-direction:column;
    gap:20px;
}

.nav-links{
    flex-direction:column;
    text-align:center;
}

.hero h1{
    font-size:40px;
}

.hero p{
    font-size:18px;
}

.stats,
.features,
.cards,
.testimonial-grid{
    flex-direction:column;
    align-items:center;
}

.card,
.feature,
.testimonial,
.stat-box{
    width:90%;
    max-width:350px;
}
}
